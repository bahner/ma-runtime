[Unit]
Description=ma runtime daemon
Documentation=https://github.com/bahner/ma-runtime
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ma
Group=ma
Environment=XDG_CONFIG_HOME=/etc
Environment=XDG_DATA_HOME=/var/log
ExecStart=/usr/bin/ma --config /etc/ma/ma.yaml --log-file /var/log/ma/ma.log
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/ma /var/log/ma

[Install]
WantedBy=multi-user.target